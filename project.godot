config_version=5

[application]
config/name="The Cinder League"
run/main_scene="res://cinder_league.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.055, 0.061, 0.065, 1)

[display]
window/size/viewport_width=1200
window/size/viewport_height=800
window/size/window_width_override=1120
window/size/window_height_override=750
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.061, 0.065, 1)
